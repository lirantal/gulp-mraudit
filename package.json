{
  "name": "gulp-mraudit",
  "version": "1.0.2",
  "description": "Mr Audit is a Gulp plugin to audit JavaScript code for security related static code analysis.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/gulp-mraudit"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint index.js",
    "test": "mocha && npm run coverage",
    "coverage": "nyc mocha ./test/*.js",
    "coveralls": "nyc report --reporter=text-lcov | coveralls",
    "build": "echo \"No build step configured\"",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml -i 'apm_modules/**' -i '.git' -i '__tests__' -i '.github' -i '.changeset' -i 'CODE_OF_CONDUCT.md' -i 'CHANGELOG.md' -i 'docs/**' -i '.superpowers/**' -i 'node_modules' -i 'dist' '**/**.md'",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "gulp",
    "build",
    "security",
    "static",
    "analysis",
    "gulpplugin",
    "audit"
  ],
  "dependencies": {
    "coveralls": "^2.11.14",
    "gulp": "^3.9.1",
    "gulp-util": "^3.0.7",
    "mocha": "^3.0.2",
    "should": "^11.1.0",
    "through2": "^2.0.1"
  },
  "author": {
    "name": "Liran Tal",
    "email": "<liran.tal@gmail.com>"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "gulp-util": "^3.0.7",
    "nyc": "^18.0.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "markdownlint-cli": "0.49.1"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  }
}
